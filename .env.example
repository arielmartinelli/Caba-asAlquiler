# ============================
# BASE DE DATOS (Neon PostgreSQL)
# ============================
# Crea tu base de datos gratis en: https://neon.tech
# En el dashboard de Neon: Settings > Connection Details
# Copiar la "Connection string" de tipo "Pooled" para DATABASE_URL
# y la de tipo "Direct" para DIRECT_URL

DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ============================
# AUTENTICACIÓN ADMIN (JWT)
# ============================
# Cambia este valor por una cadena segura aleatoria (min 32 caracteres)
JWT_SECRET="calamuchita_admin_secret_2026_santa_rosa_cambiar_esto"

# ============================
# URL DEL SITIO (para SEO y links compartidos)
# ============================
# En Vercel esta variable se setea automáticamente como VERCEL_URL
# pero ponela manualmente cuando tengas un dominio propio
NEXT_PUBLIC_SITE_URL="https://tu-dominio.vercel.app"

# ============================
# GOOGLE CALENDAR API (Opcional)
# ============================
# Para sincronizar con Google Calendar. 
# Si no lo configurás, la app funciona igual sin sync de GCal.
#
# 1. Crear un proyecto en Google Cloud Console
# 2. Habilitar la "Google Calendar API"
# 3. Crear una Service Account y descargar el JSON de credenciales
# 4. Compartir tu Google Calendar con el email de la Service Account

GOOGLE_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GOOGLE_CALENDAR_ID="tu_email@gmail.com"
